{
  "name": "renovapan",
  "version": "1.1.0",
  "private": true,
  "description": "Site e painel administrativo da RENOVAPAN.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/app.mjs",
    "dev": "node --watch server/app.mjs",
    "server": "node server/app.mjs",
    "admin:setup": "node server/setup-owner.mjs",
    "build": "tsc --noEmit && node scripts/check.mjs",
    "test": "node --test",
    "release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidagoes/Renovapan.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vidagoes/Renovapan/issues"
  },
  "homepage": "https://github.com/vidagoes/Renovapan#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
